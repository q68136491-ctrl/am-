function handleClick(e, qq, type) {
    e.preventDefault();
    e.stopPropagation();
    
    if (type === 'group') {
        const isMobile = /iPhone|Android/i.test(navigator.userAgent);
        const groupUrls = isMobile ? [
            `mqqapi://card/show_pslcard?src_type=internal&version=1&uin=${qq}&card_type=group&source=qrcode`
        ] : [
            `https://qun.qq.com/join/${qq}`
        ];
        let gIndex = 0;
        function tryGroupNext() {
            if (gIndex >= groupUrls.length) return;
            const url = groupUrls[gIndex];
            gIndex++;
            const iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            iframe.src = url;
            document.body.appendChild(iframe);
            setTimeout(() => {
                document.body.removeChild(iframe);
                if (document.hidden) return;
                if (gIndex < groupUrls.length) {
                    setTimeout(tryGroupNext, 300);
                }
            }, 150);
        }
        tryGroupNext();
        return;
    }
    
    // 好友协议（按用户指定代码）
    const isMobile = /iPhone|Android/i.test(navigator.userAgent);
    const urls = isMobile ? [
        `mqqapi://card/show_pslcard?src_type=internal&version=1&uin=${qq}&card_type=person&source=sharecard`
    ] : [
        `tencent://AddContact/?fromId=45&fromSubId=1&subcmd=all&uin=${qq}&website=AM`
    ];
    
    // 逐个尝试
    let index = 0;
    function tryNext() {
        if (index >= urls.length) return;
        const url = urls[index];
        index++;
        const iframe = document.createElement('iframe');
        iframe.style.display = 'none';
        iframe.src = url;
        document.body.appendChild(iframe);
        setTimeout(() => {
            document.body.removeChild(iframe);
            if (document.hidden) return;
            if (index < urls.length) {
                setTimeout(tryNext, 300);
            }
        }, 150);
    }
    tryNext();
}

// ==================== 复制功能（已强化） ====================
async function copyText(text) {
    // 1. 优先使用现代 Clipboard API（仅在 HTTPS / localhost 可用）
    if (navigator.clipboard && window.isSecureContext) {
        try {
            await navigator.clipboard.writeText(text);
            return true;
        } catch (err) {
            console.warn('Clipboard API 失败，尝试降级:', err);
        }
    }

    // 2. 可靠的降级方案（兼容 file://、HTTP、旧浏览器、iOS）
    try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');          // 防止键盘弹出
        ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0;z-index:-1;';
        document.body.appendChild(ta);

        // 兼容 iOS / 部分安卓
        if (navigator.userAgent.match(/ipad|iphone/i)) {
            const range = document.createRange();
            range.selectNodeContents(ta);
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
            ta.setSelectionRange(0, text.length);
        } else {
            ta.select();
            ta.setSelectionRange(0, text.length);
        }

        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return ok;
    } catch (err) {
        console.error('复制失败:', err);
        return false;
    }
}

// 复制QQ号功能
function copyQQ(qq, btn) {
    if (!qq) {
        showToast('该联系人暂无QQ号');
        return;
    }

    copyText(qq).then(success => {
        if (success) {
            btn.classList.add('copied');
            btn.textContent = '已复制';
            showToast('QQ号已复制');
            setTimeout(() => {
                btn.classList.remove('copied');
                btn.textContent = '复制号';
            }, 1500);
        } else {
            showToast('复制失败，请手动长按复制');
        }
    });
}

// 复制成功提示
function showToast(msg) {
    let toast = document.querySelector('.copy-toast');
    if (!toast) {
        toast = document.createElement('div');
        toast.className = 'copy-toast';
        document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.classList.add('show');
    setTimeout(() => {
        toast.classList.remove('show');
    }, 1200);
}

// 更新统计信息
function updateStats(total) {
    document.getElementById('stats').textContent = `共 ${total} 位预设po的联系`;
}

// 更新时间
function updateTime() {
    const now = new Date();
    const options = { 
        year: 'numeric', 
        month: '2-digit', 
        day: '2-digit', 
        hour: '2-digit', 
        minute: '2-digit', 
        second: '2-digit',
        hour12: false 
    };
    const timeStr = now.toLocaleString('zh-CN', options).replace(/\//g, '-');
    const timeEl = document.getElementById('currentTime');
    if (timeEl) timeEl.textContent = timeStr;
}

// 初始化时间并每秒更新
updateTime();
setInterval(updateTime, 1000);

// 搜索监听
const searchHint = document.getElementById('searchHint');

function toggleHint(keyword) {
    if (searchHint) {
        if (keyword) {
            searchHint.classList.add('hint-hidden');
        } else {
            searchHint.classList.remove('hint-hidden');
        }
    }
}

document.getElementById('searchInput').addEventListener('input', function(e) {
    const keyword = e.target.value.trim().toLowerCase();
    toggleHint(keyword);
    if (!keyword) { renderGroups(); renderFriends(); updateStats(contacts.length); return; }
    const filtered = contacts.filter(c => 
        c.name.toLowerCase().includes(keyword) || c.qq.includes(keyword)
    );
    const groups = filtered.filter(c => c.type === 'group');
    const friends = filtered.filter(c => c.type === 'friend');
    renderGroups(groups);
    renderFriends(friends);
    updateStats(filtered.length);
});

function renderGroups(data) {
    const list = document.getElementById('groupList');
    const section = document.getElementById('groupSection');
    const count = document.getElementById('groupCount');
    const groups = data || contacts.filter(c => c.type === 'group');
    
    count.textContent = `(${groups.length})`;
    if (groups.length === 0) {
        section.style.display = 'none';
        list.innerHTML = '';
        return;
    }
    section.style.display = 'flex';
    list.innerHTML = groups.map(c => `
        <a href="#" class="contact-card contact-card-group" onclick="handleClick(event, '\( {c.qq}', ' \){c.type}')">
            <div class="shimmer-effect"></div>
            <div class="avatar" style="background:linear-gradient(135deg,#667eea,#764ba2)">群</div>
            <div class="contact-info">
                <div class="contact-name">${c.name}</div>
                <div class="contact-qq">${c.qq}</div>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;align-items:flex-end;">
                <div class="contact-action" onclick="event.stopPropagation();copyQQ('${c.qq}', this)">复制号</div>
                <div class="contact-action">加入群聊 →</div>
            </div>
        </a>
    `).join('');
}

function renderFriends(data) {
    const list = document.getElementById('friendList');
    const section = document.getElementById('friendSection');
    const count = document.getElementById('friendCount');
    const friends = data || contacts.filter(c => c.type === 'friend');
    
    count.textContent = `(${friends.length})`;
    if (friends.length === 0) {
        section.style.display = 'none';
        list.innerHTML = '';
        return;
    }
    section.style.display = 'flex';
    list.innerHTML = friends.map(c => `
        <a href="#" class="contact-card" onclick="handleClick(event, '\( {c.qq}', ' \){c.type}')">
            <div class="shimmer-effect"></div>
            <div class="avatar">\( {c.avatarUrl ? `<img src=" \){c.avatarUrl}" onerror="this.parentElement.innerHTML='<div class=\\'avatar-fallback\\'>\( {c.name.charAt(0)}</div>'">` : `<div class="avatar-fallback"> \){c.name.charAt(0)}</div>`}</div>
            <div class="contact-info">
                <div class="contact-name">\( {c.name} \){c.isHot ? '<span class="hot-tag">热门</span>' : ''}</div>
                <div class="contact-qq">${c.qq || '暂无QQ号'}</div>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;align-items:flex-end;">
                <div class="contact-action" onclick="event.stopPropagation();copyQQ('${c.qq}', this)">复制号</div>
                <div class="contact-action">添加好友 →</div>
            </div>
        </a>
    `).join('');
}

// 初始化
renderGroups();
renderFriends();
updateStats(contacts.length);
</script>

