    position: relative;
    overflow: hidden;
}
.search-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 50%);
    pointer-events: none;
    border-radius: 24px;
}
.search-input {
    width: 100%;
    padding: 16px 20px;
    border: 2px solid rgba(255,255,255,0.3);
    border-radius: 16px;
    font-size: 16px;
    outline: none;
    transition: all 0.3s;
    background: rgba(255,255,255,0.2);
    color: white;
}
.search-input::placeholder { color: rgba(255,255,255,0.6); }
.search-input:focus {
    border-color: rgba(255,255,255,0.6);
