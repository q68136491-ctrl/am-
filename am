/* 动态背景气泡 */
.bg-bubble {
    position: fixed;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
    animation: float 20s infinite ease-in-out;
    z-index: 0;
}
.bg-bubble:nth-child(1) { width: 300px; height: 300px; top: -100px; left: -100px; animation-delay: 0s; }
.bg-bubble:nth-child(2) { width: 200px; height: 200px; top: 50%; right: -50px; animation-delay: -5s; }
.bg-bubble:nth-child(3) { width: 250px; height: 250px; bottom: -80px; left: 30%; animation-delay: -10s; }
.bg-bubble:nth-child(4) { width: 180px; height: 180px; top: 20%; left: 60%; animation-delay: -15s; }
@keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    33% { transform: translateY(-30px) rotate(120deg); }
    66% { transform: translateY(30px) rotate(240deg); }
}

/* Shimmer 反光扫过动画 */
@keyframes shimmer {
    0% { transform: translateX(-100%) skewX(-15deg); }
    100% { transform: translateX(200%) skewX(-15deg); }
}
.shimmer-effect {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.15) 50%, transparent 100%);
    animation: shimmer 4s infinite ease-in-out;
    pointer-events: none;
    border-radius: inherit;
}
.container {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
}
.header {
    text-align: center;
    margin-bottom: 30px;
}
.header h1 {
